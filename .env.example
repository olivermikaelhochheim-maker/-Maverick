# Maverick configuration. `pnpm configure` creates a real .env from this for you.
# Never commit .env. It is listed in .gitignore.

# --- Required -------------------------------------------------------------
# 32-byte key (base64) that encrypts conversations and settings at rest.
# LOSE THIS AND YOUR DATA CANNOT BE DECRYPTED. Keep a copy in your password manager.
# On macOS, `pnpm configure` can keep it in the Keychain instead of this file.
MAVERICK_DATA_KEY=

# One-time code for creating your account on first launch.
MAVERICK_SETUP_CODE=

# --- AI model -------------------------------------------------------------
# Leave empty to run in free mock mode. On macOS, prefer the Keychain (pnpm configure offers it).
ANTHROPIC_API_KEY=
# mock | anthropic | (empty = anthropic if a key is found, otherwise mock)
MAVERICK_LLM_PROVIDER=

# --- Notifications (Web Push) ----------------------------------------------
# Generated by `pnpm configure`. The private key can live in the macOS Keychain instead.
MAVERICK_VAPID_PUBLIC_KEY=
MAVERICK_VAPID_PRIVATE_KEY=
# Contact address sent to push services (Apple/Google), e.g. mailto:you@example.com
MAVERICK_VAPID_SUBJECT=

# --- Google Calendar (read-only) ---------------------------------------------
# From Google Cloud Console → Credentials → OAuth client (Web application). See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The address Google sends you back to after connecting. Must match the redirect URI
# registered in Google Cloud: <this URL>/api/integrations/google/callback
MAVERICK_PUBLIC_URL=http://localhost:3000
# mock = demo calendar for trying things out
MAVERICK_CALENDAR_PROVIDER=

# --- Storage --------------------------------------------------------------
# Embedded database folder (default: ./data/pglite in the project).
MAVERICK_DATA_DIR=
# Set to use a PostgreSQL server instead (cloud deployment), e.g. postgres://user:pass@host/db
DATABASE_URL=

# --- Advanced -------------------------------------------------------------
# 1 = always mark cookies Secure (set when serving over HTTPS), 0 = never, empty = auto
MAVERICK_COOKIE_SECURE=
# 1 only when behind a trusted reverse proxy that sets X-Forwarded-For
MAVERICK_TRUST_PROXY=
# Extra origins allowed to make changes, comma-separated. Set to your Tailscale
# address if you use `tailscale serve`, e.g. https://olivers-macbook.tail1234.ts.net
MAVERICK_ALLOWED_ORIGINS=
# debug | info | warn | error
MAVERICK_LOG_LEVEL=info
# off = don't run briefings/reminders in this process
MAVERICK_SCHEDULER=
